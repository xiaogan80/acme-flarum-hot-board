{
    "name": "acme/flarum-hot-board",
    "description": "在讨论列表上方显示「推荐帖子 / 最新帖子 / 热门浏览」三列看板，每条自动填充帖子首图或用户头像。",
    "type": "flarum-extension",
    "keywords": ["flarum", "widget", "board", "hot"],
    "license": "MIT",
    "require": {
        "flarum/core": "^2.0.0"
    },
    "autoload": {
        "psr-4": {
            "Acme\\HotBoard\\": "src/"
        }
    },
    "extra": {
        "flarum-extension": {
            "title": "热点帖子看板",
            "category": "forum-widget",
            "icon": {
                "name": "fas fa-fire",
                "backgroundColor": "#e8590c",
                "color": "#fff"
            }
        }
    }
}
